flowchart LR
  %% --- Dark theme styling ---
  classDef meta fill:#2f2f2f,stroke:#aaaaaa,color:#ffffff,stroke-dasharray:3 2;
  classDef orchestrate fill:#1e3a8a,stroke:#3b82f6,color:#ffffff,stroke-width:1px;
  classDef compute fill:#7c2d12,stroke:#f97316,color:#ffffff,stroke-width:1px;
  classDef data fill:#064e3b,stroke:#34d399,color:#ffffff,stroke-width:1px;
  classDef ext fill:#3f3f46,stroke:#a1a1aa,color:#ffffff,stroke-dasharray:3 2;

  %% --- Dev & GitHub ---
  Dev["Developer"]:::ext
  GH["GitHub Repo"]:::ext

  %% --- GitHub Actions DAG ---
  subgraph GHA["GitHub Actions
  – CI/CD Workflow"]
    Start["Workflow Start
    (push to main)"]:::meta
    PyCheck["Python Build Check
    (syntax, deps, lint)"]:::compute
    TFApply["Terraform Apply
    (provision EC2, EMR, S3)"]:::compute
    Image["Build & Push
    Airflow Docker Image
    (includes DAGs)"]:::compute
    Deploy["Pull New Image on EC2
    (restart Airflow)"]:::compute
    End["Workflow End"]:::meta

    Start --> PyCheck --> TFApply --> Image --> Deploy --> End
  end

  %% --- AWS Environment ---
  subgraph AWS["AWS Environment"]
    EC2["Airflow (EC2 container)
    – Orchestrator\nDAGs baked into image"]:::orchestrate
    EMR["Spark on EMR
    – Transformation Engine"]:::compute
    S3["S3 Buckets
    (raw / curated)"]:::data
  end

  %% --- Outer flow ---
  Dev -->|"git push (main)"| GH
  GH -->|"trigger workflow"| GHA

  TFApply -->|"create/update infra"| AWS
  Deploy -->|"pull new image\n(run docker compose up)"| EC2
