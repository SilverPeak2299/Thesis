flowchart LR
  %% --- Dark theme styling ---
  classDef meta fill:#2f2f2f,stroke:#aaaaaa,color:#ffffff,stroke-dasharray:3 2;
  classDef orchestrate fill:#1e3a8a,stroke:#3b82f6,color:#ffffff,stroke-width:1px;
  classDef compute fill:#7c2d12,stroke:#f97316,color:#ffffff,stroke-width:1px;
  classDef data fill:#064e3b,stroke:#34d399,color:#ffffff,stroke-width:1px;

  %% --- Nodes ---
  Start["DAG Start<br/>(schedule/manual)"]:::meta
  Ingest["Ingest Raw Data<br/>(Python task: fetch & write S3 raw)"]:::compute
  Submit["Submit Spark Job<br/>(EMR step: transform raw → curated)"]:::orchestrate
  Wait["Wait for Completion<br/>(poll EMR step status)"]:::orchestrate
  Manifest["Record Manifest<br/>(S3 output paths)"]:::data
  End["DAG End"]:::meta

  %% --- Flow ---
  Start --> Ingest --> Submit --> Wait --> Manifest --> End
